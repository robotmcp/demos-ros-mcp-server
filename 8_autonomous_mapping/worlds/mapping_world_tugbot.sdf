<?xml version="1.0" ?>
<!--
  4-room mapping world for TugBot autonomous SLAM.
  Contains multiple rooms, corridors, and obstacles.
  Approximate size: 10m x 10m with 4 rooms.
  World name MUST be "world_demo" to match TugBot's Ignition scan topic path.
-->
<sdf version="1.8">
  <world name="world_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-contact-system.so"
            name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>1</grid>
    </scene>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         OUTER WALLS (10m x 10m perimeter, centered at origin)
         Wall height: 1.0m (taller for TugBot LiDAR), thickness: 0.1m
         ============================================================ -->

    <!-- North wall (y=5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall (y=-5) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (x=5) -->
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (x=-5) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 10.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 10.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         INTERNAL WALLS - Creates 4 rooms + corridors
         Room layout:
           NW room | corridor | NE room
           --------|----------|--------
           SW room | corridor | SE room
         Gaps of ~2m for corridors between rooms
         ============================================================ -->

    <!-- Horizontal divider wall (center, with 2m gap for corridor) -->
    <!-- Left section -->
    <model name="wall_h_left">
      <static>true</static>
      <pose>-3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.7 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Right section -->
    <model name="wall_h_right">
      <static>true</static>
      <pose>3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.7 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vertical divider wall (center, with gaps) -->
    <!-- Top section -->
    <model name="wall_v_top">
      <static>true</static>
      <pose>0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.7 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bottom section -->
    <model name="wall_v_bottom">
      <static>true</static>
      <pose>0 -3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 3.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 3.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.7 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ROOM FEATURES - obstacles/furniture inside rooms
         ============================================================ -->

    <!-- NW Room: L-shaped obstacle -->
    <model name="obstacle_nw_1">
      <static>true</static>
      <pose>-3.0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.1 1.0</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1</ambient><diffuse>0.4 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_nw_2">
      <static>true</static>
      <pose>-3.75 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 1.0 1.0</size></box></geometry>
          <material><ambient>0.3 0.5 0.3 1</ambient><diffuse>0.4 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- NE Room: Box obstacles -->
    <model name="obstacle_ne_1">
      <static>true</static>
      <pose>2.5 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.4 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_ne_2">
      <static>true</static>
      <pose>3.8 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.4 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient><diffuse>0.4 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SW Room: Cylinder pillars -->
    <model name="pillar_sw_1">
      <static>true</static>
      <pose>-2.5 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.7 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_sw_2">
      <static>true</static>
      <pose>-3.5 -3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.7 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SE Room: Diagonal wall -->
    <model name="obstacle_se_1">
      <static>true</static>
      <pose>3.0 -3.0 0.5 0 0 0.7854</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 0.1 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.3 1</ambient><diffuse>0.6 0.6 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central corridor obstacles -->
    <model name="corridor_obstacle_1">
      <static>true</static>
      <pose>0 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 1.0</size></box></geometry>
          <material><ambient>0.5 0.3 0.5 1</ambient><diffuse>0.6 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corridor_obstacle_2">
      <static>true</static>
      <pose>0 -1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 1.0</size></box></geometry>
          <material><ambient>0.5 0.3 0.5 1</ambient><diffuse>0.6 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TugBot (loaded from Ignition Fuel) — spawned in NW room -->
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot</uri>
      <name>tugbot</name>
      <pose>-2.5 2.5 0.132279 0 0 0</pose>
    </include>

  </world>
</sdf>
