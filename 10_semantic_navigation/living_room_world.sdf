<?xml version="1.0" ?>
<!--
  Custom living-room environment for the semantic navigation robot.

  Design constraints:
  - Original robot geometry is embedded directly, so /odom, /scan, camera,
    IMU, and /cmd_vel behave like the known-good house world.
  - Navigable routes are intentionally wide: the central free space and all
    main passages are at least 1.2 m, roughly 3x the robot width.
  - Fuel furniture assets are visual-only. Simple static primitive collisions
    avoid unstable mesh contacts and floating chairs.
-->
<sdf version="1.8">
  <world name="living_room_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.62 0.60 0.56 1</ambient>
      <background>0.78 0.84 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.92 0.86 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.25 -1.0</direction>
    </light>

    <light type="point" name="warm_room_light">
      <pose>-3.9 3.6 2.5 0 0 0</pose>
      <diffuse>0.95 0.78 0.52 1</diffuse>
      <specular>0.15 0.12 0.08 1</specular>
      <attenuation>
        <range>9</range>
        <constant>0.8</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Floor -->
    <model name="warm_wood_floor">
      <static>true</static>
      <pose>0 0 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 10 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 10 0.05</size></box></geometry>
          <material>
            <ambient>0.48 0.36 0.23 1</ambient>
            <diffuse>0.56 0.42 0.27 1</diffuse>
            <specular>0.08 0.06 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls, 12 m x 10 m room. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.12 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.12 2.5</size></box></geometry>
          <material><ambient>0.86 0.84 0.78 1</ambient><diffuse>0.93 0.90 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.12 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.12 2.5</size></box></geometry>
          <material><ambient>0.86 0.84 0.78 1</ambient><diffuse>0.93 0.90 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 10 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 10 2.5</size></box></geometry>
          <material><ambient>0.86 0.84 0.78 1</ambient><diffuse>0.93 0.90 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 10 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.12 10 2.5</size></box></geometry>
          <material><ambient>0.86 0.84 0.78 1</ambient><diffuse>0.93 0.90 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Short architectural features only; central room stays open. -->
    <model name="low_media_divider">
      <static>true</static>
      <pose>3.7 1.7 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.16 0.9</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.16 0.9</size></box></geometry>
          <material><ambient>0.72 0.70 0.64 1</ambient><diffuse>0.82 0.79 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="area_rug">
      <static>true</static>
      <pose>-1.2 -0.6 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.8 2.2 0.02</size></box></geometry>
          <material><ambient>0.18 0.22 0.32 1</ambient><diffuse>0.22 0.28 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fuel sofa asset, fixed and parked against the south wall. -->
    <model name="fuel_sofa_static">
      <static>true</static>
      <pose>-3.6 -4.05 0 0 0 0</pose>
      <link name="body">
        <collision name="clear_box">
          <pose>0 0 0.38 0 0 0</pose>
          <geometry><box><size>2.35 0.8 0.76</size></box></geometry>
        </collision>
        <visual name="fuel_sofa_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/sofa/2/files/meshes/Sofa.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Fuel chairs, static, with primitive collisions so they cannot levitate. -->
    <model name="fuel_chair_left_static">
      <static>true</static>
      <pose>3.8 -3.55 0 0 0 2.35</pose>
      <link name="body">
        <collision name="clear_box">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.68 0.68 0.9</size></box></geometry>
        </collision>
        <visual name="fuel_chair_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/chair/2/files/meshes/Chair.obj</uri>
              <scale>0.00817 0.00817 0.00817</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="fuel_chair_right_static">
      <static>true</static>
      <pose>4.75 -2.55 0 0 0 2.7</pose>
      <link name="body">
        <collision name="clear_box">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>0.68 0.68 0.9</size></box></geometry>
        </collision>
        <visual name="fuel_chair_visual">
          <pose>0 0 0 0 0 1.5708</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/chair/2/files/meshes/Chair.obj</uri>
              <scale>0.00817 0.00817 0.00817</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Fuel TV stand visual plus simple screen, all static and wall-adjacent. -->
    <model name="fuel_tv_stand_static">
      <static>true</static>
      <pose>0 4.55 0 0 0 0</pose>
      <link name="stand">
        <collision name="clear_box">
          <pose>0 0 0.32 0 0 0</pose>
          <geometry><box><size>2.0 0.5 0.64</size></box></geometry>
        </collision>
        <visual name="fuel_tv_stand_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/tvstand/1/files/meshes/TVStand.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <link name="screen">
        <pose>0 -0.18 1.05 0 0 0</pose>
        <collision name="screen_box"><geometry><box><size>1.35 0.06 0.72</size></box></geometry></collision>
        <visual name="screen_visual">
          <geometry><box><size>1.35 0.04 0.72</size></box></geometry>
          <material>
            <ambient>0.02 0.025 0.03 1</ambient>
            <diffuse>0.02 0.025 0.03 1</diffuse>
            <emissive>0.05 0.12 0.18 1</emissive>
          </material>
        </visual>
      </link>
      <joint name="screen_fixed" type="fixed"><parent>stand</parent><child>screen</child></joint>
    </model>

    <model name="bookshelf_static">
      <static>true</static>
      <pose>-5.35 2.0 0.75 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.5 1.4 1.5</size></box></geometry></collision>
        <visual name="case">
          <geometry><box><size>0.5 1.4 1.5</size></box></geometry>
          <material><ambient>0.30 0.19 0.11 1</ambient><diffuse>0.40 0.26 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="plant_static">
      <static>true</static>
      <pose>5.15 3.7 0.35 0 0 0</pose>
      <link name="pot">
        <collision name="collision"><geometry><cylinder><radius>0.22</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.35</length></cylinder></geometry>
          <material><ambient>0.42 0.23 0.12 1</ambient><diffuse>0.52 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
      <link name="leaves">
        <pose>0 0 0.52 0 0 0</pose>
        <collision name="collision"><geometry><sphere><radius>0.36</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.36</radius></sphere></geometry>
          <material><ambient>0.08 0.36 0.12 1</ambient><diffuse>0.12 0.50 0.18 1</diffuse></material>
        </visual>
      </link>
      <joint name="leaves_fixed" type="fixed"><parent>pot</parent><child>leaves</child></joint>
    </model>

    <model name="side_table_static">
      <static>true</static>
      <pose>-5.0 -3.85 0.32 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.65 0.65 0.64</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 0.64</size></box></geometry>
          <material><ambient>0.36 0.27 0.18 1</ambient><diffuse>0.45 0.34 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wide_window_north">
      <static>true</static>
      <pose>-3.4 4.92 1.45 0 0 0</pose>
      <link name="link">
        <visual name="glass">
          <geometry><box><size>2.3 0.03 0.9</size></box></geometry>
          <material>
            <ambient>0.42 0.62 0.72 0.55</ambient>
            <diffuse>0.42 0.62 0.72 0.55</diffuse>
            <emissive>0.04 0.07 0.09 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Original known-good VLA robot. -->
    <model name="vla_bot">
      <pose>0 -3.2 0.1 0 0 1.5707</pose>
      <self_collide>false</self_collide>

      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.15</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <sensor name="rgb_camera" type="camera">
          <pose>0.2 0 0.1 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>camera/image</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
        </sensor>

        <sensor name="gpu_lidar" type="gpu_lidar">
          <pose>0 0 0.15 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>scan</topic>
          <gz_frame_id>vla_bot/base_link/gpu_lidar</gz_frame_id>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>0.01</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
          </ray>
        </sensor>

        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <topic>imu</topic>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <link name="caster">
        <pose>-0.15 0 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="c">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
      </joint>
      <joint name="caster_joint" type="ball">
        <parent>base_link</parent><child>caster</child>
      </joint>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <max_linear_acceleration>2.0</max_linear_acceleration>
        <min_linear_acceleration>-2.0</min_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <min_angular_acceleration>-3.0</min_angular_acceleration>
        <max_linear_velocity>1.0</max_linear_velocity>
        <min_linear_velocity>-1.0</min_linear_velocity>
        <max_angular_velocity>2.0</max_angular_velocity>
        <min_angular_velocity>-2.0</min_angular_velocity>
      </plugin>

      <plugin filename="ignition-gazebo-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>

      <plugin filename="ignition-gazebo-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_sensor_pose>true</publish_sensor_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>1</static_update_frequency>
      </plugin>
    </model>

  </world>
</sdf>
